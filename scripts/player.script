// Top-level: typed commands + per-game input layout.
// Each `command` decl is a typed intent event: name plus a record of
// `(type field;)*` params. Param types currently supported:
//   entity   — entity_t (4 bytes, uint32 bitfield id:18 + version:12)
//   point    — 2D world coords (2 × fixed_t = 8 bytes)
// `input { }` is the anonymous per-game input layout.


command cast_ability {
    entity target_entity;
}

command cast_ability_ground {
    point position;
}

input {
    button fire
    button jump
    button crouch
    stick  move
    stick  aim
}

// Player prefab.
// Attributes are flat (tag, fixed_t value) pairs — no schema, no defaults
// beyond what's listed here. Hooks on the spawned entity run when matching
// events arrive (hierarchical match: `on damage` catches damage.fire,
// .frost, ...).

prefab player {
    tags {
        unit.player
    }

    attributes {
        health     = 100
        health.max = 100
        mana       = 50
        mana.max   = 50
        haste      = 0
    }

    on init {
        self.health = self.health.max
        self.mana   = self.mana.max
    }

    on damage {
        self.health -= event.amount
        if (self.health <= 0) {
            despawn
        }
    }
}
